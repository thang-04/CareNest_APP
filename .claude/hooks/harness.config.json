{
  "repo": "APP",
  "siblings": {
    "BE": [
      "../CareNest_BE"
    ],
    "FE": [
      "../CareNest_FE"
    ],
    "APP": [
      "../CareNest_APP"
    ]
  },
  "lanes": {
    "smallMaxFiles": 2,
    "mediumMaxFiles": 8,
    "riskGlobs": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock*",
      ".nvmrc",
      ".npmrc",
      "app.json",
      "eas.json",
      "android/**/build.gradle*",
      "android/gradle.properties",
      "ios/Podfile*",
      "pubspec.yaml",
      "pubspec.lock",
      "lib/core/**",
      "lib/routing/**",
      "lib/app.dart"
    ]
  },
  "verify": {
    "activeWhen": [
      "package.json",
      "pubspec.yaml"
    ],
    "globs": [
      "src/**",
      "package.json",
      "tsconfig*.json",
      "app.json",
      "android/**",
      "ios/**",
      "lib/**",
      "test/**",
      "assets/**",
      "pubspec.yaml",
      "analysis_options.yaml"
    ],
    "display": "node scripts/verify.mjs"
  },
  "guard": {
    "dependencyGlobs": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock*",
      ".nvmrc",
      ".npmrc",
      "app.json",
      "eas.json",
      "android/**/build.gradle*",
      "android/gradle.properties",
      "ios/Podfile*",
      "pubspec.yaml",
      "pubspec.lock"
    ],
    "immutableGlobs": [],
    "contractGlobs": [],
    "highRisk": [],
    "sharedGlobs": [
      "lib/core/**",
      "lib/routing/**",
      "lib/app.dart"
    ],
    "autonomous": true
  },
  "checkAiLayer": {
    "pathRoots": [
      "docs",
      ".ai"
    ],
    "incidentIdPattern": "^APP-(BUG|CASE|ENV|CTR)-\\d{6}-[a-z0-9-]+$"
  }
}
