{
  "repo": "APP",
  "siblings": {
    "BE": [
      "../CareNest_BE-main",
      "../CareNest_BE"
    ],
    "FE": [
      "../CareNest_FE"
    ],
    "APP": [
      "../CareNest_APP"
    ]
  },
  "lanes": {
    "smallMaxFiles": 2,
    "mediumMaxFiles": 8,
    "riskGlobs": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock*",
      ".nvmrc",
      ".npmrc",
      "app.json",
      "eas.json",
      "android/**/build.gradle*",
      "android/gradle.properties",
      "ios/Podfile*"
    ]
  },
  "verify": {
    "activeWhen": [
      "package.json"
    ],
    "globs": [
      "src/**",
      "package.json",
      "tsconfig*.json",
      "app.json",
      "android/**",
      "ios/**"
    ],
    "display": "node scripts/verify.mjs"
  },
  "guard": {
    "dependencyGlobs": [
      "package.json",
      "package-lock.json",
      "pnpm-lock.yaml",
      "yarn.lock",
      "bun.lock*",
      ".nvmrc",
      ".npmrc",
      "app.json",
      "eas.json",
      "android/**/build.gradle*",
      "android/gradle.properties",
      "ios/Podfile*"
    ],
    "immutableGlobs": [],
    "contractGlobs": [],
    "highRisk": []
  },
  "checkAiLayer": {
    "pathRoots": [
      "docs",
      ".ai"
    ],
    "incidentIdPattern": "^APP-(BUG|CASE|ENV|CTR)-\\d{6}-[a-z0-9-]+$",
    "sharedFiles": [
      ".claude/settings.json",
      ".claude/hooks/*.mjs",
      ".claude/hooks/lib/**",
      ".claude/hooks/__tests__/**",
      ".githooks/**",
      "scripts/**",
      ".gitattributes",
      ".editorconfig",
      "docs/plans/_TEMPLATE.md"
    ]
  }
}
